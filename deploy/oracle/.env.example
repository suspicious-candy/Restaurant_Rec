# Copy to .env on the VM and fill in. .env is read by docker compose from THIS
# directory. Never commit it.
#
# These are the same three values that were in env.yaml for Cloud Run, plus the
# hostname Caddy requests a certificate for.

# Atlas connection string. Unchanged from Cloud Run -- but see README.md step 8:
# Atlas network access is IP-allowlisted, and the VM's address is new.
mongo_url="mongodb+srv://USER:PASS@cluster0.dopn1h8.mongodb.net/"
MONGO_DB="test"

# The same hex string Vercel sends. Copy it from the existing env.yaml rather
# than generating a new one, or /index/missing starts 401ing after cutover.
RECOMMENDER_TOKEN="paste-the-same-hex-string-you-give-vercel"

# The public hostname. With no domain of your own, use sslip.io: substitute your
# VM's public IP with dashes, e.g. 140.238.1.2 becomes 140-238-1-2.sslip.io
SITE_ADDRESS="140-238-1-2.sslip.io"
