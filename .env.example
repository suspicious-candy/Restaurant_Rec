# Copy to `.env` for local development, or set these as real environment
# variables in production. Do NOT commit `.env` — it is gitignored, and it used
# to be tracked, which is why the rule now exists.
#
# PRECEDENCE: the real environment always wins. service.py calls load_dotenv,
# which does not override variables that are already set, so a container's
# `-e` flags beat anything in a file.

# MongoDB connection string — the SAME database the Next app uses. The
# recommender reads restaurant text from it to build vectors.
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
mongo_url=

# Database name. The app's connection string historically carried none, so
# everything landed in a database literally called "test", which is the default
# here for that reason. Set both sides together when you rename it.
MONGO_DB=test

# Where Chroma's SQLite index lives. Relative paths resolve against the working
# directory, which is why the service used to have to be started from this
# folder. In Docker this is a mounted volume — the index is ~550MB and is a
# derived artifact, so it is neither committed nor baked into the image.
#   chroma_db        in development
#   /data/chroma     in the container
CHROMA_DIR=chroma_db

# Shared secret guarding POST /index/missing, which reads Mongo and runs the
# embedding model inside the request. Leave blank on a laptop; the service
# prints a warning at startup and the endpoint stays open.
#
# On any reachable host, SET THIS, and set the identical value as
# RECOMMENDER_TOKEN in the Next app so its two callers can send it. Generate
# one with `openssl rand -hex 32`.
RECOMMENDER_TOKEN=

# Development convenience only: where to look for a .env file. Defaults to
# ../palate/.env so a laptop with both repos checked out side by side needs no
# configuration at all. Unused in production, where the environment is real.
# RECOMMENDER_ENV_FILE=../palate/.env
